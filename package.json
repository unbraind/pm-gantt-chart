{
  "name": "pm-gantt-chart",
  "version": "2026.10.26",
  "description": "Gantt chart renderer for pm-cli with ASCII, SVG, HTML and Mermaid exports, dependency-aware scheduling and Triplicate styling.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbraind/pm-gantt-chart.git"
  },
  "bugs": {
    "url": "https://github.com/unbraind/pm-gantt-chart/issues"
  },
  "homepage": "https://pm-cli.unbrained.dev/packages/pm-gantt-chart",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "manifest.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run brand:build && tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node --test test/*.test.ts",
    "prepublishOnly": "npm run release:check",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "verify:release-workflow": "node .agents/pm/verify-release-yaml.ts",
    "verify:release-changelog-date": "node scripts/verify-release-changelog-date.ts",
    "verify:release-publish-attestation": "node scripts/verify-release-publish-attestation.ts",
    "docstring": "node scripts/docstring-gate.ts",
    "audit:prod": "node --input-type=module -e \"import { spawnSync } from 'node:child_process'; import { devNull } from 'node:os'; const env = { ...process.env, npm_config_userconfig: devNull, NPM_CONFIG_USERCONFIG: devNull }; for (const key of Object.keys(env)) if (key.toLowerCase() === 'npm_config_allow_scripts') delete env[key]; const win = process.platform === 'win32'; const r = spawnSync(win ? 'npm.cmd' : 'npm', ['audit', '--omit=dev', '--ignore-scripts'], { stdio: 'inherit', env, shell: win }); process.exit(r.status ?? 1);\"",
    "accept:packed": "node scripts/accept-packed.ts",
    "pack:dry-run": "npm pack --dry-run",
    "changelog": "pm-changelog --pm-root .agents/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded --mode prepend --output CHANGELOG.md --release-version-from-package --date-from-version --since-previous-tag --until-release-tag --item-url-base https://github.com/unbraind/pm-gantt-chart/blob/main/.agents/pm --respect-item-release --pm-bin ./node_modules/.bin/pm",
    "changelog:full": "pm-changelog --pm-root .agents/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded --mode replace --output CHANGELOG.md --all-release-tags --release-version-from-package --date-from-version --item-url-base https://github.com/unbraind/pm-gantt-chart/blob/main/.agents/pm --respect-item-release --pm-bin ./node_modules/.bin/pm",
    "changelog:check": "pm-changelog --pm-root .agents/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded --mode replace --output CHANGELOG.md --all-release-tags --release-version-from-package --date-from-version --item-url-base https://github.com/unbraind/pm-gantt-chart/blob/main/.agents/pm --respect-item-release --pm-bin ./node_modules/.bin/pm --check",
    "release:check": "npm run brand:check && npm run check && npm run lint && npm run duplication && npm run verify:release-workflow && npm run docstring && npm run coverage && npm run audit:prod && npm run pack:dry-run && npm run accept:packed && npm run changelog:check && npm run verify:release-changelog-date && npm run verify:release-publish-attestation",
    "release:notes": "pm-changelog --pm-root .agents/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded --stdout --since-previous-tag --until-release-tag --release-version-from-package --date-from-version --item-url-base https://github.com/unbraind/pm-gantt-chart/blob/main/.agents/pm --respect-item-release --pm-bin ./node_modules/.bin/pm --github-step-summary",
    "lint": "node scripts/lint.ts",
    "duplication": "node scripts/duplication-gate.ts",
    "prepare": "node scripts/prepare-merge-driver.ts",
    "merge:install": "pm merge install",
    "coverage": "npm run build && npm run build:test && node scripts/coverage-gate.ts",
    "brand:build": "node scripts/brand-values.ts",
    "brand:check": "node scripts/brand-values.ts --check"
  },
  "peerDependencies": {
    "@unbrained/pm-cli": ">=2026.10.20"
  },
  "devDependencies": {
    "@babel/eslint-parser": "8.0.7",
    "@babel/plugin-syntax-typescript": "8.0.3",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.5",
    "@unbrained/pm-cli": "2026.10.20",
    "eslint": "10.13.0",
    "jscpd": "5.4.2",
    "pm-brand": "github:unbraind/pm-brand#505f386aaa68c0947b9380eae9cfe74dc48e47c7",
    "pm-changelog": "2026.10.20",
    "pm-ops": "2026.10.20",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "keywords": [
    "ascii",
    "gantt",
    "pm-cli",
    "pm-cli-extension",
    "pm-extension",
    "pm-package",
    "project-management",
    "timeline"
  ],
  "author": {
    "name": "unbrained",
    "url": "https://unbrained.dev/about"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "pm": {
    "aliases": [
      "gantt"
    ],
    "extensions": [
      "."
    ],
    "catalog": {
      "display_name": "Gantt Chart",
      "category": "visualization",
      "summary": "ASCII Gantt chart renderer for pm-cli",
      "tags": [
        "gantt",
        "timeline",
        "planning"
      ],
      "links": {
        "docs": "https://github.com/unbraind/pm-gantt-chart#readme",
        "npm": "https://www.npmjs.com/package/pm-gantt-chart",
        "repository": "https://github.com/unbraind/pm-gantt-chart",
        "report": "https://github.com/unbraind/pm-gantt-chart/issues"
      }
    },
    "docs": [
      "README.md",
      "CHANGELOG.md"
    ],
    "examples": [
      "README.md"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "duplicationGate": {
    "threshold": 0,
    "minTokens": 50
  },
  "coverageGate": {
    "sources": [
      "."
    ],
    "tests": [
      "test/*.test.ts"
    ],
    "thresholds": {
      "lines": 100,
      "branches": 100,
      "functions": 100
    },
    "ignore": []
  }
}
