  npx pm health,project,pi-glm,"2026-10-04T10:13:33.943Z",local_mutation,chore/pm-gantt-chart-pm-cli-2026-10-4
  npx -y @unbrained/pm-cli@2026.10.4 gantt export --format json --output gantt.json,project,pi-glm,"2026-10-04T10:13:35.446Z",local_mutation,chore/pm-gantt-chart-pm-cli-2026-10-4
  bunx @unbrained/pm-cli@2026.10.4 gantt export --format json --output gantt-bun.json,project,pi-glm,"2026-10-04T10:13:36.552Z",local_mutation,chore/pm-gantt-chart-pm-cli-2026-10-4
