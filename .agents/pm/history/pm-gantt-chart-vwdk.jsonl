{"ts":"2026-08-31T10:41:03.715Z","author":"claude-orchestrator","author_source":"asserted","agent_harness":"claude-code","agent_instance":"c41a528b9f424137989cc889","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-gantt-chart-vwdk"},{"op":"add","path":"/metadata/title","value":"Split codeql-action bumps deadlock the codeql check, because init and analyze can only pass together"},{"op":"add","path":"/metadata/description","value":"Dependabot opens github/codeql-action/init and github/codeql-action/analyze as two separate pull requests, but the two actions must carry the same version in a workflow, so each pull request alone leaves the pair mismatched and the codeql check fails on BOTH. Measured 2026-08-31 in this repository: pull request 87 bumped init and 88 bumped analyze, and codeql was the only failing check on each while every other check was green, so neither could ever merge. This change lands both bumps in one commit and adds a dependabot groups block so future codeql-action bumps arrive as a single pull request."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-31T10:41:03.715Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-31T10:41:03.715Z"},{"op":"add","path":"/metadata/author","value":"claude-orchestrator"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"cd18c94d1ccbb45bdb5cda1937035cb010cbb8ac14d08ff2c61d4092701a15fa","item_hash_version":2,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"}}}}
