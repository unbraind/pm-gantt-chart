    path: test/scheduler.test.ts
    scope: project
    assert_stdout_contains[1]: thresholds met
    note: 100/100/100 at the raised floor
close_reason: "index.ts reaches 100 percent lines, branches and functions with the gate thresholds raised to 100/100/100. Nine defensive guards were removed after verifying at their call sites that each was unreachable; the reachable arms gained tests through the real command handlers."
